# --- LLM del agente: "openai" | "anthropic" | "gemini" | "openrouter" ---
LLM_PROVIDER="openrouter"
# Opcional: pisa el modelo por defecto del provider (ver DEFAULT_MODEL_POR_PROVIDER en config.py)
LLM_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# --- Embeddings del RAG: "openai" (text-embedding-3-small) o "gemini" (gemini-embedding-001 a 1536 dims) ---
EMBEDDING_PROVIDER="gemini"

# --- Pinecone (vector store del RAG) ---
PINECONE_API_KEY=""
INDEX_NAME="coderhouse-rag"
PINECONE_NAMESPACE="genpet-docs"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
